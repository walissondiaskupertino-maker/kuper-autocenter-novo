# Local development uses SQLite automatically; no .env file is required.
# Uncomment and fill these values to connect to MySQL:
# SECRET_KEY=generate-a-unique-secret
# DB_USER=your_database_user
# DB_PASSWORD=your_local_database_password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=kuper_autocenter

# Production must set APP_ENV=production, SECRET_KEY, and DATABASE_URL
# (or DB_USER and DB_PASSWORD with the DB_HOST/DB_PORT/DB_NAME values above).
